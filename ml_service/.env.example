# TrustLens-AI ML Microservice Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
SERVICE_NAME=trustlens-ml-service
SERVICE_VERSION=1.0.0

# Security & CORS (Comma-separated or JSON list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:5173

# NLI & Embedding Model Settings (For upcoming phases)
NLI_MODEL_NAME=cross-encoder/nli-deberta-v3-small
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
SIMILARITY_THRESHOLD=0.65
MAX_EVIDENCE_SNIPPETS=3
